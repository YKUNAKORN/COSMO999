# Firebase Realtime Database - project dummy-ae198
# Copy this file to .env.local and replace every value with the real one
# from Firebase console > Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dummy-ae198
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Optional. Root node for every RTDB path. Defaults to "dummyRoom", the live
# production data used by the legacy app. While testing anything that WRITES
# to the database, set this to "dummyRoom_dev" so the real scores are never
# touched; once the feature works, delete this line (or set it back to
# "dummyRoom") to run against production again.
NEXT_PUBLIC_RTDB_ROOT=dummyRoom
